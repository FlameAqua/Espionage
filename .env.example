# Copy to `.env` and fill in before building a release.
#
# GitHub token embedded into the build so the INSTALLED app can read releases
# from the PRIVATE update repo via electron-updater.
#
# Use a FINE-GRAINED personal access token scoped to ONLY the update repo, with
# read-only "Contents" permission and nothing else. Anyone who unpacks the app
# can extract this token, so it must never grant more than read access to that
# one repository. Rotate it if it leaks.
#
# electron-vite only inlines vars prefixed with MAIN_VITE_ into the main bundle.
MAIN_VITE_UPDATE_TOKEN=
